# رابط الاتصال بقاعدة PostgreSQL المحلية (studix)
# عدّل المستخدم/كلمة المرور/المنفذ حسب إعداد جهازك، ثم انسخ هذا الملف إلى .env
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/studix"

# منفذ الـ backend API
PORT=4000

# أصل الفرونت-إند المحلي (لـ CORS + كوكي الجلسة) — عدّله لو Vite يعمل على منفذ مختلف
FRONTEND_ORIGIN=http://localhost:5173

# سرّ توقيع جلسة تسجيل الدخول (Phase 3A) — يبقى فقط على الخادم، لا يصل أبداً للفرونت-إند.
# ولّد قيمة عشوائية طويلة، مثال: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── إعدادات كوكي الجلسة (اختيارية) — Production Readiness Fix، Finding 2 ──
# القيم الافتراضية (لو حُذف السطران التاليان بالكامل) صحيحة فعلياً لتوبولوجي هذا
# التطبيق المعتمَد: تطبيق سطح مكتب/محلي لكل معلّم على جهازه الخاص (الباك-إند
# وPostgreSQL والواجهة الأمامية كلها على نفس الجهاز، بلا reverse proxy، عادة بلا
# HTTPS حقيقي). لا تُفعِّل COOKIE_SECURE بلا HTTPS فعلي — المتصفح سيرفض إرسال الكوكي
# كلياً فيُكسِر تسجيل الدخول تماماً.
# COOKIE_SECURE=false
# COOKIE_SAME_SITE=lax
